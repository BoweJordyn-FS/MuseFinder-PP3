# Copy this file to .env and fill in the values.
# cp .env.dist .env

# MongoDB connection string used by server.js
DATABASEURL=mongodb://localhost:27017/musefinder

# Port the Express server listens on (defaults to 3001 if unset)
PORT=3001

# Secret used to sign JWTs in config.js (defaults to 'secretkey' if unset — set this in production)
JWT_SECRET=
