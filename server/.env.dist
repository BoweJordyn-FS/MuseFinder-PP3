# Copy this file to .env and fill in the values.
# cp .env.dist .env

# MongoDB connection string used by server.js
DATABASEURL=mongodb://localhost:27017/musefinder

# Port the Express server listens on (defaults to 3001 if unset)
PORT=3001

# Secret used to sign JWTs in config.js. Required — the server refuses to start without it.
JWT_SECRET=

# Spotify API credentials (register your app at https://developer.spotify.com/dashboard/)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where Spotify sends the browser after login. Register this exact URL in the
# Spotify dashboard. Use your Render URL in production.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/spotify/v1/callback

# Where /callback sends the browser once tokens are stored
CLIENT_URL=http://localhost:3000
